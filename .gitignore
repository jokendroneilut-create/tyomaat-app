# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# Mittausten valiaikaistiedostot
ab-*.json
*.tmp.ts

# Claude Code -paikallinen tila. Worktreet ovat kokonaisia repokopioita
# (4 kpl, 25 MB, 2933 tiedostoa), joten ilman tata "git add -A" veisi
# repoon toisten haarojen koko lahdepuun.
**/.claude/settings.local.json
**/.claude/worktrees/
**/.claude/scheduled_tasks.lock
# app/.claude/launch.json toistaa juuren konfiguraation mutta kovakoodatulla
# absoluuttisella polulla (--prefix C:\Users\...), joten se on koneriippuva.
app/.claude/launch.json

# Mittausajojen valitulokset (kymmenia megatavuja, ei kuulu historiaan)
scripts/out/pairs-*.json
# Katselmointilistat sisaltavat henkilotietoa - repo on julkinen.
scripts/out/contact-mismatches.json
scripts/out/granlund-review.json
scripts/out/design-firms*.json
scripts/out/foundation-*.json
scripts/out/housing-company-key.json

# Kilpailija-aineiston sanatarkat litteraatit jaavat koneelle: repo on
# julkinen, ja koko haastattelun litterointi on kolmannen osapuolen teoksen
# jakamista. Analyysi (README.md) on omaa tekstia lyhyine sitaatteineen ja
# kuuluu historiaan; litteraatti on sen lahdeaineisto ja tarkistettavissa
# aikaleimoista alkuperaiselta videolta.
docs/competitors/**/litteraatti.txt
